APP_NAME="Edulab LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# For private servers behind reverse proxies (Nginx/Cloudflare),
# set FORCE_HTTPS to true to force HTTPS schema generation
FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
# SQLite is great for development/testing and simple hosting.
# MySQL/PostgreSQL is highly recommended for production scale.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edulab_lms
DB_USERNAME=root
DB_PASSWORD=

# For SQLite deployment on shared hosting:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# Session/Cache/Queue Drivers
# Note: LMS is optimized with database drivers for cross-server robustness out-of-the-box.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateway (Paystack)
PAYSTACK_PUBLIC_KEY=pk_live_yourinstancekey
PAYSTACK_SECRET_KEY=sk_live_yourinstancekey

# Optional AWS S3 integration if standard disk size is limited
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# deployment checklist on private servers:
# 1. Run "composer install --no-dev -o"
# 2. Run "php artisan key:generate"
# 3. Create database and run "php artisan migrate --force --seed"
# 4. Run "php artisan storage:link" to make uploaded logos/favicons public
# 5. Build assets: "npm install && npm run build"
# 6. Optimize config/routes: "php artisan config:cache && php artisan route:cache && php artisan view:cache"
